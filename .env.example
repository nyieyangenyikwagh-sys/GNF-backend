# Local development (when running the API outside Docker)
DATABASE_URL=postgresql+psycopg2://rcm:rcm@localhost:5432/rcm
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
JWT_ISSUER=gnf-claims
JWT_AUDIENCE=gnf-api
RULES_ENGINE_URL=
FRAUD_ENGINE_URL=
SERVICE_TOKEN=
DEPENDENCY_TIMEOUT_SECONDS=2
DEPENDENCY_MAX_RETRIES=2
RECOVERY_INTERVAL_SECONDS=30
RECOVERY_MAX_ATTEMPTS=10
MAX_REQUEST_BYTES=1048576

# Next.js client (rcm-platform-frontend/.env.local)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
